# Copy to .env and fill in values (never commit .env)
# copy .env.example .env

# ── Local development (default) ─────────────────────────────────────────────
# Use with: docker compose up -d  +  uvicorn  +  npm run dev

GEMINI_API_KEY=
GEMINI_API_KEY_2=
# Cheapest first, then Gemini 3 / standard flash
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite,gemini-2.5-flash,gemini-3.5-flash,gemini-3-flash-preview

JWT_SECRET=ekip-dev-secret-change-in-prod

# Local auth (required for password login)
AUTH_MODE=password
BOOTSTRAP_USER_PASSWORD=choose-an-initial-user-password
MODEL_DEVICE=cpu
DOCUMENT_STORAGE_BACKEND=local

# Trust-RAG local demo flags (enable full pipeline locally)
EVIDENCE_EXTRACTION_ENABLED=true
EVIDENCE_GRAPH_ENABLED=true
TEMPORAL_API_ENABLED=true
CLAIM_VERIFICATION_ENABLED=true

# If this file later gains cloud DATABASE_URL / QDRANT_URL, local Docker helpers
# still work with: LOCAL_STACK=1  (set automatically by run_local_trust_stack.*)
# LOCAL_STACK=1

POSTGRES_USER=ekip
POSTGRES_PASSWORD=ekip_dev_2026
POSTGRES_DB=ekip
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── Cloud production (Supabase + Qdrant Cloud) ───────────────────────────────
# Comment out POSTGRES_* / QDRANT_HOST when using these:

# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@db.xxxxx.supabase.co:5432/postgres?sslmode=require
# Password with @ → URL-encode (%40). Example: Knowledgebase@2026 → Knowledgebase%402026
# QDRANT_URL=https://xxxxxxxx.us-east-1-0.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-api-key

# Comma-separated frontend URLs (add your Vercel URL after deploy)
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173,http://localhost:5174

# Optional: separate collection if you deploy v1 and v2 later
# QDRANT_COLLECTION=enterprise_docs
